  "structures": [
    {
      "id": "no-solo",
      "regex": "(?i)\\bno (?:es|se trata de) (?:solo|sólo|solamente) [^.!?\\n]{2,60}[,.;] (?:es|se trata)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di lo único que de verdad quieres decir. Borra la mitad que prepara."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Elige uno. El que tenga el número."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.!,;] se trata de\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Empieza por Y y deja X fuera."
    },
    {
      "id": "pregunta-retorica",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|la clave|el truco|la trampa|lo peor)\\?\\s*$",
      "name": "Línea de pregunta retórica",
      "fix": "Dilo directo, sin la pausa dramática."
    },
    {
      "id": "lo-que-aprendi",
      "regex": "(?i)\\besto es lo que (?:aprendí|aprendimos)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Di lo que aprendiste, sin anunciarlo."
    },
    {
      "id": "regla-de-tres",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
      "name": "Tríada de tres",
      "fix": "Quédate con el que más pesa. Las listas de tres suenan a plantilla."
    },
    {
      "id": "emoji-tipico",
      "regex": "[🚀🔥💡✨🎯]",
      "name": "Emoji cohete / fuego / ampolleta / brillo / diana",
      "fix": "Bórralo o cámbialo por uno que solo tú usarías."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5+)",
      "fix": "Instagram cuenta máximo 5. Usa 3 a 5 de tema, al final."
    },
    {
      "id": "autorreferencia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
      "name": "El modelo hablando de sí mismo",
      "fix": "Bórralo."
    },
    {
      "id": "cierre-ensayo",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en definitiva|en síntesis)\\b",
      "name": "Cierre de ensayo escolar",
      "fix": "Termina en el último dato útil, no en un resumen."
    },
    {
      "id": "cebo-reflejo",
      "regex": "(?im)¿?(?:estás de acuerdo|qué opinas|quién más|me equivoco|tú qué dices)\\?\\s*$",
      "name": "Pregunta de enganche por reflejo",
      "fix": "Haz una pregunta que solo tu audiencia pueda responder, o ninguna."
    },
    {
      "id": "deja-de-scrollear",
      "regex": "(?im)^\\s*(?:deja de (?:scrollear|deslizar)|no (?:sigas|pases) (?:deslizando|de largo))\\b",
      "name": "Abre con \"deja de scrollear\"",
      "fix": "Abre con lo que importa."
    },
    {
      "id": "preambulo",
      "regex": "(?i)\\b(?:en (?:este|el) (?:video|reel|post)(?: de hoy)?|hoy te voy a (?:mostrar|enseñar)|te voy a (?:mostrar|enseñar) c[oó]mo)\\b",
      "name": "Preámbulo de video (\"en este video te voy a mostrar\")",
      "fix": "Bórralo y parte por el resultado."
    },
    {
      "id": "lista-emoji",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨]\\s*\\S",
      "name": "Lista con emojis de viñeta",
      "fix": "Usa guiones, o escribe un párrafo."
    },
    {
      "id": "gritos",
      "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
      "name": "Tres o más palabras en mayúsculas seguidas",
      "fix": "Deja en mayúscula una, o ninguna."
    },
    {
      "id": "cebo-seguir",
      "regex": "(?i)\\b(?:s[ií]gueme para m[aá]s|etiqueta a (?:alguien|ese amig[oa]|tu amig[oa])|dale (?:like|me gusta|doble tap) si|comp[aá]rtelo con (?:alguien|quien))\\b",
      "name": "Pedir follow o etiquetas por reflejo",
      "fix": "Un solo llamado a la acción, y que sirva para algo."
    },
    {
      "id": "tu-senal",
      "regex": "(?i)\\best[ae] es tu señal (?:para|de)\\b",
      "name": "\"Esta es tu señal para...\"",
      "fix": "Di directamente qué tiene que hacer y por qué."
    },
    {
      "id": "imagina-mundo",
      "regex": "(?i)\\bimagina un mundo (?:donde|en el que)\\b",
      "name": "\"Imagina un mundo donde...\"",
      "fix": "Muestra el caso real en vez de imaginarlo."
    },
    {
      "id": "amplia-gama",
      "regex": "(?i)\\b(?:una )?(?:amplia gama|gran variedad|infinidad|gran cantidad) de\\b",
